---
// Props pasados desde index.astro
const { types_data, application_types, id } = Astro.props;
import { markdownify } from "@/lib/utils/textConverter";
---

<section class="section" id={id}>
  <div class="container px-4 mx-auto">

    <div class="flex justify-center text-center mb-16">
      <h2 class="h2">{application_types.head}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {types_data.map((item: any, index: number) => (
        <div class="group relative flex flex-col p-8 bg-theme-light dark:bg-darkmode-theme-light rounded-2xl transition-all duration-300 hover:-translate-y-2 overflow-hidden border border-border dark:border-darkmode-border shadow-sm hover:shadow-lg">
          
          <div class="absolute -top-4 -right-4 text-9xl font-black text-text dark:text-darkmode-text opacity-5 transition-all duration-500 select-none z-0 pointer-events-none">
            {(index + 1).toString().padStart(2, '0')}
          </div>

          <div class="relative z-10 w-full h-full flex flex-col">
            <div class="w-10 h-1.5 bg-primary mb-6 rounded-full group-hover:w-16 transition-all duration-300"></div>
            
            <h3 class="h4 font-bold leading-tight mb-4 text-dark dark:text-white">
              {item.title}
            </h3>
            
            <div class="text-text dark:text-light text-base leading-relaxed" set:html={markdownify(item.content)}></div>
          </div>
          
        </div>
      ))}
    </div>
  </div>
</section>
