---
const { source, className } = Astro.props;

import {
  Phone,
  Globe,
  MapPin,
  BehanceLogo,
  CodepenLogo,
  DiscordLogo,
  DribbbleLogo,
  FacebookLogo,
  GithubLogo,
  GitlabLogo,
  InstagramLogo,
  LinkedinLogo,
  MediumLogo,
  PinterestLogo,
  RedditLogo,
  Rss,
  SkypeLogo,
  SlackLogo,
  SnapchatLogo,
  SoundcloudLogo,
  TiktokLogo,
  TwitterLogo,
  WhatsappLogo,
  YoutubeLogo,
  EnvelopeSimple,
} from "@phosphor-icons/react";

const {
  facebook,
  twitter,
  mastodon,
  instagram,
  youtube,
  linkedin,
  github,
  gitlab,
  discord,
  slack,
  medium,
  codepen,
  bitbucket,
  dribbble,
  behance,
  pinterest,
  soundcloud,
  tumblr,
  reddit,
  vk,
  whatsapp,
  snapchat,
  vimeo,
  tiktok,
  foursquare,
  rss,
  email,
  phone,
  address,
  skype,
  website,
} = source;
---

<ul class={className}>
  {
    facebook && (
      <li class="inline-block">
        <a
          aria-label="facebook"
          href={facebook}
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          <FacebookLogo weight="fill" />
        </a>
      </li>
    )
  }
